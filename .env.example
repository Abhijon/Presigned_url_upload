# AWS RDS PostgreSQL Connection String
# Format: postgresql://<username>:<password>@<rds-endpoint>:5432/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@upload-service-db.XXXXXX.ap-south-1.rds.amazonaws.com:5432/postgres?schema=public"

# AWS S3 Credentials
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=upload-project-abhijon

# Upload Configuration
MAX_FILE_SIZE_MB=5
PRESIGNED_URL_EXPIRY_SECONDS=300
